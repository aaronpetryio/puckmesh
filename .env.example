# Copy to .env and fill in. .env is gitignored; never commit real values.

# Workspace URL, e.g. https://dbc-xxxxxxxx-xxxx.cloud.databricks.com
DATABRICKS_HOST=
# Personal access token (Settings > Developer > Access tokens)
DATABRICKS_TOKEN=
# SQL warehouse > Connection details > HTTP path, e.g. /sql/1.0/warehouses/abc123
DATABRICKS_HTTP_PATH=

# Your personal dbt schema prefix in the dev catalog (dev.<DBT_SCHEMA>_bronze, ...)
DBT_SCHEMA=dbt_apetry
