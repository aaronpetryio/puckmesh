# SQL lint/format rules. The human-readable version is docs/style-guide/sql.md.
# Based on dbt Labs' own config (github.com/dbt-labs/jaffle-shop/.sqlfluff), adapted
# for Databricks. Deviations from it are marked and explained in the style guide.
#
#   sqlfluff lint transform      # report
#   sqlfluff fix transform       # rewrite in place

[sqlfluff]
dialect = databricks
# The jinja templater with dbt builtins stubs ref()/source()/var()/config(), so linting
# needs no warehouse connection or credentials (CI and pre-commit can run it anywhere).
# The dbt templater would be more exact but must compile against a live profile.
templater = jinja
# Deviation: dbt Labs uses 80. VARIANT paths plus casts don't fit in 80 without
# wrapping nearly every column.
max_line_length = 100
indent_unit = space
# structure.column_order: fights dbt's "group columns by type" ordering.
exclude_rules = structure.column_order

[sqlfluff:templater:jinja]
apply_dbt_builtins = True

[sqlfluff:indentation]
tab_space_size = 4
# Keep the first join condition on the `on` line, as in dbt's examples:
#     left join goals
#         on goals.game_id = shots.game_id
#         and goals.event_index < shots.event_index
indented_on_contents = False

[sqlfluff:layout:type:comma]
spacing_before = touch
line_position = trailing

[sqlfluff:rules:capitalisation.keywords]
capitalisation_policy = lower

[sqlfluff:rules:capitalisation.identifiers]
extended_capitalisation_policy = lower

[sqlfluff:rules:capitalisation.functions]
extended_capitalisation_policy = lower

[sqlfluff:rules:capitalisation.literals]
capitalisation_policy = lower

[sqlfluff:rules:aliasing.table]
aliasing = explicit

[sqlfluff:rules:aliasing.column]
aliasing = explicit

[sqlfluff:rules:convention.casting_style]
# `::` is already required for VARIANT paths (payload:_meta.season_id::int).
preferred_type_casting_style = shorthand

[sqlfluff:rules:convention.not_equal]
preferred_not_equal_style = c_style

[sqlfluff:rules:ambiguous.column_references]
# Name the columns: group by game_id, period. Not 1, 2 and not `all`.
group_by_and_order_by_style = explicit
